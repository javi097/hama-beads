<file path="src/hama/core/quantizer.ts">
import type { BeadCell, HamaColor } from '@/interfaces/hama.interface'

export interface RgbColor {
  r: number
  g: number
  b: number
}

/**
 * Calcula la distancia Redmean entre un píxel y un color de la paleta.
 * Distancia euclidiana RGB ponderada perceptualmente según luminancia.
 */
export function redmeanDistance(
  r1: number,
  g1: number,
  b1: number,
  color: HamaColor
): number {
  const rmean = (r1 + color.r) / 2
  const dr = r1 - color.r
  const dg = g1 - color.g
  const db = b1 - color.b
  return Math.sqrt(
    (2 + rmean / 256) * dr * dr +
      4 * dg * dg +
      (2 + (255 - rmean) / 256) * db * db
  )
}

/**
 * Determina si un color de la paleta es neutro / acromático (escala de grises: saturación <= 15).
 * Abarca Blanco, Negro, Grises y Plateado.
 */
export function isNeutralColor(color: HamaColor): boolean {
  const sat = Math.max(color.r, color.g, color.b) - Math.min(color.r, color.g, color.b)
  return sat <= 15
}

/**
 * Determina si un color es un gris neutro intermedio (#17, #71, #77, #62).
 * Excluye los extremos puros blanco (#01) y negro (#18).
 */
export function isNeutralGray(color: HamaColor): boolean {
  return isNeutralColor(color) && color.id !== '01' && color.id !== '18'
}

/**
 * Calcula el tono (Hue) en grados [0, 360) a partir de componentes RGB.
 * Devuelve -1 si el color es perfectamente acromático (saturación = 0).
 */
export function getHue(r: number, g: number, b: number): number {
  const max = Math.max(r, g, b)
  const min = Math.min(r, g, b)
  const d = max - min
  if (d === 0) return -1

  let h = 0
  if (max === r) {
    h = ((g - b) / d) % 6
  } else if (max === g) {
    h = (b - r) / d + 2
  } else {
    h = (r - g) / d + 4
  }
  h = Math.round(h * 60)
  if (h < 0) h += 360
  return h
}

/**
 * Calcula la menor diferencia angular entre dos tonos en grados [0, 180].
 */
export function hueDiff(h1: number, h2: number): number {
  if (h1 < 0 || h2 < 0) return 180
  const diff = Math.abs(h1 - h2)
  return Math.min(diff, 360 - diff)
}

/**
 * Encuentra el color más cercano en la paleta activa aplicando Redmean
 * con protecciones acromáticas para negros profundos y escala de grises.
 */
export function findClosestColor(
  r: number,
  g: number,
  b: number,
  palette: HamaColor[]
): HamaColor {
  if (palette.length === 0) {
    throw new Error('La paleta activa no puede estar vacía')
  }

  const maxVal = Math.max(r, g, b)
  const minVal = Math.min(r, g, b)
  const sat = maxVal - minVal
  const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255

  // 2. Contraste de siluetas y entintado (Ojos y contornos negros):
  // Todo píxel de línea de contorno o cavidad oscura con luminancia < 0.22 y saturación baja (< 20)
  // debe colapsar limpiamente a #18 Negro (#000000), evitando halos grises (#62, #71, #77) en los bordes.
  // Incluye también sombras profundas (luminancia < 0.12 o RGB < 35 con sat < 25).
  const isContourOrDeepShadow =
    (luminance < 0.22 && sat < 20) ||
    (luminance < 0.12 && sat < 25) ||
    (r < 35 && g < 35 && b < 35 && sat < 25)

  if (isContourOrDeepShadow) {
    const black = palette.find((c) => c.id === '18')
    if (black) {
      return black
    }
  }

  // 1. Corrección del sesgo a grises en colores de baja saturación:
  // La restricción acromática (#18, #71, #17, #01) SOLO debe aplicarse si la saturación es prácticamente nula:
  // Math.max(r, g, b) - Math.min(r, g, b) < 8.
  let candidatePalette = palette
  if (sat < 8) {
    const neutralPalette = palette.filter(isNeutralColor)
    if (neutralPalette.length > 0) {
      candidatePalette = neutralPalette
    }
  }

  // Si sat >= 8 y existe un canal dominante o tendencia cromática,
  // se debe respetar el tono cromático evitando que se elijan grises neutros (#17, #71, #62, #77).
  const hasDominantChannel = sat >= 8
  const pixelHue = getHue(r, g, b)
  const hasChromaticBeads = candidatePalette.some((c) => !isNeutralColor(c))

  let minDistance = Infinity
  let closest = candidatePalette[0]

  for (let i = 0; i < candidatePalette.length; i++) {
    const color = candidatePalette[i]
    const colorIsNeutralGray = isNeutralGray(color)

    // Si el píxel tiene información cromática (sat >= 8) y existen perlas cromáticas en la paleta,
    // se descartan o penalizan fuertemente los grises neutros (#17, #71, #62, #77)
    if (hasDominantChannel && colorIsNeutralGray && hasChromaticBeads) {
      const penaltyDistance = redmeanDistance(r, g, b, color) + 500
      if (penaltyDistance < minDistance) {
        minDistance = penaltyDistance
        closest = color
      }
      continue
    }

    let distance = redmeanDistance(r, g, b, color)

    // 3. Ponderación perceptual del tono dominante (Hue):
    // Pondera con mayor peso la coherencia del tono para evitar que un color desaturado
    // prefiera un color de tono opuesto o un gris.
    if (pixelHue >= 0 && !isNeutralColor(color)) {
      const cHue = getHue(color.r, color.g, color.b)
      const hDiff = hueDiff(pixelHue, cHue) // [0, 180]
      distance += (hDiff / 180) * 120
    }

    if (distance < minDistance) {
      minDistance = distance
      closest = color
    }
  }

  return closest
}

/**
 * Determina si un píxel de fondo debe descartarse según RF-6.3.
 * Solo activo si el fondo detectado es claro (R, G, B > 240) y distancia RGB <= 20.
 */
export function isBackgroundPixel(
  r: number,
  g: number,
  b: number,
  bgR: number,
  bgG: number,
  bgB: number
): boolean {
  if (bgR > 240 && bgG > 240 && bgB > 240) {
    const dr = r - bgR
    const dg = g - bgG
    const db = b - bgB
    const distance = Math.sqrt(dr * dr + dg * dg + db * db)
    return distance <= 20
  }
  return false
}

/**
 * Detecta el color predominante del fondo muestreando las 4 esquinas de la imagen.
 */
export function detectBackgroundColor(
  imageData: Uint8ClampedArray,
  cols: number,
  rows: number
): RgbColor {
  if (cols <= 0 || rows <= 0 || imageData.length < 4) {
    return { r: 255, g: 255, b: 255 }
  }

  const corners = [
    0, // Top-left (0, 0)
    (cols - 1) * 4, // Top-right (cols - 1, 0)
    (rows - 1) * cols * 4, // Bottom-left (0, rows - 1)
    ((rows - 1) * cols + (cols - 1)) * 4, // Bottom-right (cols - 1, rows - 1)
  ]

  let sumR = 0
  let sumG = 0
  let sumB = 0
  let validPoints = 0

  for (const idx of corners) {
    if (idx + 2 < imageData.length) {
      sumR += imageData[idx]
      sumG += imageData[idx + 1]
      sumB += imageData[idx + 2]
      validPoints++
    }
  }

  if (validPoints === 0) {
    return { r: 255, g: 255, b: 255 }
  }

  return {
    r: Math.round(sumR / validPoints),
    g: Math.round(sumG / validPoints),
    b: Math.round(sumB / validPoints),
  }
}

/**
 * Procesa un píxel individual y devuelve la celda correspondiente (color o null).
 */
export function processPixel(
  r: number,
  g: number,
  b: number,
  alpha: number,
  bg: RgbColor,
  removeBg: boolean,
  palette: HamaColor[]
): BeadCell {
  if (alpha < 120) {
    return null
  }

  if (removeBg && isBackgroundPixel(r, g, b, bg.r, bg.g, bg.b)) {
    return null
  }

  return findClosestColor(r, g, b, palette)
}
</file>

<file path="src/hama/hooks/useCanvasRenderer.ts">
import { useEffect, type RefObject } from 'react'
import type { BeadType, GridData } from '@/interfaces/hama.interface'

export interface CanvasRendererOptions {
  zoom: number
  showGrid: boolean
  showCodes: boolean
  beadShape: 'hollow' | 'pixel'
  highlightedColorId: string | null
  beadType: BeadType
  darkMode: boolean
  dpr?: number
}

const RULER_OFFSET = 26

/**
 * Calcula el tamaño en píxeles de cada celda a partir de la resolución y el factor de zoom.
 */
export function calcCellSize(cols: number, rows: number, zoom: number): number {
  const maxDim = Math.max(1, cols, rows)
  const baseCellSize = Math.max(14, Math.min(34, Math.floor(560 / maxDim)))
  return Math.round(baseCellSize * zoom)
}

/**
 * Calcula las dimensiones lógicas en píxeles del canvas (área de dibujo + reglas).
 */
export function calcCanvasDimensions(
  cols: number,
  rows: number,
  cellSize: number,
  rulerOffset: number = RULER_OFFSET
): { width: number; height: number } {
  return {
    width: cols * cellSize + rulerOffset,
    height: rows * cellSize + rulerOffset,
  }
}

/**
 * Dibuja la cuadrícula 2D completa compensando Device Pixel Ratio (DPR) para nitidez.
 */
export function renderGrid2D(
  canvas: HTMLCanvasElement,
  gridData: GridData | null,
  options: CanvasRendererOptions
): void {
  const ctx = canvas.getContext('2d')
  if (!ctx) return

  if (!gridData || gridData.cols <= 0 || gridData.rows <= 0) {
    ctx.clearRect(0, 0, canvas.width, canvas.height)
    return
  }

  const { cols, rows, cells } = gridData
  const {
    zoom,
    showGrid,
    showCodes,
    beadShape,
    highlightedColorId,
    beadType,
    darkMode,
  } = options

  const dpr = options.dpr ?? (typeof window !== 'undefined' ? window.devicePixelRatio || 1 : 1)
  const cellSize = calcCellSize(cols, rows, zoom)
  const rulerOffset = RULER_OFFSET
  const { width: displayWidth, height: displayHeight } = calcCanvasDimensions(
    cols,
    rows,
    cellSize,
    rulerOffset
  )

  // Ajustar tamaño físico para nitidez HiDPI / Retina (Principio 7 de la Constitución)
  canvas.width = Math.round(displayWidth * dpr)
  canvas.height = Math.round(displayHeight * dpr)
  canvas.style.width = `${displayWidth}px`
  canvas.style.height = `${displayHeight}px`

  ctx.save()
  ctx.scale(dpr, dpr)
  ctx.clearRect(0, 0, displayWidth, displayHeight)

  // 1. Fondo de reglas superior e izquierda
  ctx.fillStyle = darkMode ? '#1e293b' : '#e2e8f0'
  ctx.fillRect(0, 0, displayWidth, rulerOffset)
  ctx.fillRect(0, 0, rulerOffset, displayHeight)

  // 2. Numeración de coordenadas de reglas
  ctx.fillStyle = darkMode ? '#94a3b8' : '#475569'
  ctx.font = 'bold 10px sans-serif'
  ctx.textAlign = 'center'
  ctx.textBaseline = 'middle'

  for (let x = 0; x < cols; x++) {
    if (cellSize >= 16 || (x + 1) % 5 === 0 || x === 0) {
      ctx.fillText(String(x + 1), rulerOffset + x * cellSize + cellSize / 2, rulerOffset / 2)
    }
  }

  for (let y = 0; y < rows; y++) {
    if (cellSize >= 16 || (y + 1) % 5 === 0 || y === 0) {
      ctx.fillText(String(y + 1), rulerOffset / 2, rulerOffset + y * cellSize + cellSize / 2)
    }
  }

  // 3. Dibujar celdas, fondo ajedrezado, clavijas y perlas
  for (let y = 0; y < rows; y++) {
    for (let x = 0; x < cols; x++) {
      const px = rulerOffset + x * cellSize
      const py = rulerOffset + y * cellSize
      const color = cells[y]?.[x]

      // Fondo ajedrezado sutil
      ctx.fillStyle =
        (x + y) % 2 === 0
          ? darkMode
            ? '#0f172a'
            : '#f8fafc'
          : darkMode
            ? '#131c31'
            : '#f1f5f9'
      ctx.fillRect(px, py, cellSize, cellSize)

      // Clavija central de la placa base
      ctx.fillStyle = darkMode ? '#334155' : '#cbd5e1'
      ctx.beginPath()
      ctx.arc(
        px + cellSize / 2,
        py + cellSize / 2,
        Math.max(1.5, cellSize * 0.08),
        0,
        Math.PI * 2
      )
      ctx.fill()

      if (color) {
        const isDimmed = highlightedColorId !== null && highlightedColorId !== color.id
        ctx.save()

        // Atenuación de color según RF-11.1
        if (isDimmed) {
          ctx.globalAlpha = 0.18
        }

        const cx = px + cellSize / 2
        const cy = py + cellSize / 2

        if (beadShape === 'hollow') {
          // Perla cilíndrica: disco sólido si showCodes activo (el hueco solaparía el texto),
          // cilíndrica con hueco interior si showCodes está desactivado.
          const outerRadius = cellSize * 0.45

          ctx.beginPath()
          ctx.arc(cx, cy, outerRadius, 0, Math.PI * 2)
          ctx.fillStyle = color.hex
          ctx.fill()

          ctx.lineWidth = Math.max(1, cellSize * 0.04)
          ctx.strokeStyle = 'rgba(0,0,0,0.28)'
          ctx.stroke()

          if (!showCodes) {
            // Hueco central oscuro (solo cuando no se muestran códigos)
            const innerRadius = cellSize * 0.18
            ctx.beginPath()
            ctx.arc(cx, cy, innerRadius, 0, Math.PI * 2)
            ctx.fillStyle = darkMode ? '#0f172a' : '#e2e8f0'
            ctx.fill()
          }
        } else {
          // Cuadrado sólido (Modo Pixel Art)
          ctx.fillStyle = color.hex
          ctx.fillRect(px + 1, py + 1, cellSize - 2, cellSize - 2)
        }

        // El texto del código se dibuja SIEMPRE al final (última capa) para que
        // nada lo solape. Color calculado exclusivamente por luminancia intrínseca
        // de la perla; nunca depende del tema (darkMode).
        if (showCodes) {
          ctx.fillStyle = color.luminance > 0.5 ? '#000000' : '#ffffff'
          ctx.font = `bold ${Math.max(8, Math.floor(cellSize * 0.45))}px monospace`
          ctx.textAlign = 'center'
          ctx.textBaseline = 'middle'
          ctx.fillText(color.id, cx, cy)
        }

        ctx.restore()
      }
    }
  }

  // 4. Dibujar líneas de cuadrícula y divisiones de placas estándar
  if (showGrid) {
    const pegSize = beadType.pegboardSize

    // Líneas verticales
    for (let x = 0; x <= cols; x++) {
      const px = rulerOffset + x * cellSize
      const isPegBorder = x > 0 && x % pegSize === 0

      ctx.beginPath()
      ctx.moveTo(px, rulerOffset)
      ctx.lineTo(px, displayHeight)
      ctx.strokeStyle = isPegBorder
        ? '#ef4444'
        : darkMode
          ? 'rgba(148,163,184,0.22)'
          : 'rgba(71,85,105,0.22)'
      ctx.lineWidth = isPegBorder ? 2 : 1
      ctx.stroke()
    }

    // Líneas horizontales
    for (let y = 0; y <= rows; y++) {
      const py = rulerOffset + y * cellSize
      const isPegBorder = y > 0 && y % pegSize === 0

      ctx.beginPath()
      ctx.moveTo(rulerOffset, py)
      ctx.lineTo(displayWidth, py)
      ctx.strokeStyle = isPegBorder
        ? '#ef4444'
        : darkMode
          ? 'rgba(148,163,184,0.22)'
          : 'rgba(71,85,105,0.22)'
      ctx.lineWidth = isPegBorder ? 2 : 1
      ctx.stroke()
    }
  }

  ctx.restore()
}

/**
 * Hook para sincronizar el dibujo en el elemento canvas con los cambios de estado.
 */
export function useCanvasRenderer(
  canvasRef: RefObject<HTMLCanvasElement | null>,
  gridData: GridData | null,
  options: CanvasRendererOptions
): void {
  const {
    zoom,
    showGrid,
    showCodes,
    beadShape,
    highlightedColorId,
    beadType,
    darkMode,
    dpr,
  } = options

  useEffect(() => {
    const canvas = canvasRef.current
    if (!canvas) return
    renderGrid2D(canvas, gridData, {
      zoom,
      showGrid,
      showCodes,
      beadShape,
      highlightedColorId,
      beadType,
      darkMode,
      dpr,
    })
  }, [
    canvasRef,
    gridData,
    zoom,
    showGrid,
    showCodes,
    beadShape,
    highlightedColorId,
    beadType,
    darkMode,
    dpr,
  ])
}
</file>

