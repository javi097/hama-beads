<file path="src/hama/components/Controls/ViewerToolbar.tsx">
import { useHamaStore } from '@/hama/store/hama.store'
import { cn } from '@/lib/utils'

interface Props {
  className?: string
}

export default function ViewerToolbar({ className }: Props) {
  const zoom = useHamaStore((state) => state.zoom)
  const showGrid = useHamaStore((state) => state.showGrid)
  const showCodes = useHamaStore((state) => state.showCodes)
  const beadShape = useHamaStore((state) => state.beadShape)
  const removeBg = useHamaStore((state) => state.removeBg)

  const setZoom = useHamaStore((state) => state.setZoom)
  const setShowGrid = useHamaStore((state) => state.setShowGrid)
  const setShowCodes = useHamaStore((state) => state.setShowCodes)
  const setBeadShape = useHamaStore((state) => state.setBeadShape)
  const setRemoveBg = useHamaStore((state) => state.setRemoveBg)

  const handleZoomIn = () => {
    setZoom(zoom + 0.25)
  }

  const handleZoomOut = () => {
    setZoom(zoom - 0.25)
  }

  return (
    <div className={cn('flex flex-wrap items-center gap-2 text-xs', className)}>
      {/* Controles de Zoom */}
      <div className="flex items-center bg-slate-100 dark:bg-slate-800 rounded-lg border border-slate-300 dark:border-slate-700 px-2 py-1">
        <button
          type="button"
          onClick={handleZoomOut}
          disabled={zoom <= 0.5}
          className="px-1.5 font-bold hover:text-indigo-600 disabled:opacity-40 cursor-pointer disabled:cursor-not-allowed"
          title="Reducir zoom"
        >
          −
        </button>
        <span className="px-2 font-mono text-[11px] font-semibold min-w-12 text-center">
          {Math.round(zoom * 100)}%
        </span>
        <button
          type="button"
          onClick={handleZoomIn}
          disabled={zoom >= 3.0}
          className="px-1.5 font-bold hover:text-indigo-600 disabled:opacity-40 cursor-pointer disabled:cursor-not-allowed"
          title="Aumentar zoom"
        >
          +
        </button>
      </div>

      {/* Toggle Cuadrícula */}
      <button
        type="button"
        onClick={() => setShowGrid(!showGrid)}
        className={cn(
          'px-2.5 py-1.5 rounded-lg font-medium border transition cursor-pointer',
          showGrid
            ? 'bg-indigo-500/10 border-indigo-500/30 text-indigo-600 dark:text-indigo-400'
            : 'bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400'
        )}
      >
        # Cuadrícula
      </button>

      {/* Toggle Códigos */}
      <button
        type="button"
        onClick={() => setShowCodes(!showCodes)}
        className={cn(
          'px-2.5 py-1.5 rounded-lg font-medium border transition cursor-pointer',
          showCodes
            ? 'bg-indigo-500/10 border-indigo-500/30 text-indigo-600 dark:text-indigo-400'
            : 'bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400'
        )}
      >
        🆔 Códigos
      </button>

      {/* Toggle Forma de Perla */}
      <button
        type="button"
        onClick={() => setBeadShape(beadShape === 'hollow' ? 'pixel' : 'hollow')}
        className="px-2.5 py-1.5 rounded-lg font-medium bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer"
        title="Alternar apariencia de perla / píxel"
      >
        {beadShape === 'hollow' ? '⭕ Perla' : '⬛ Píxel'}
      </button>

      {/* Toggle Eliminación de Fondo (RF-6.2) */}
      <button
        type="button"
        onClick={() => setRemoveBg(!removeBg)}
        className={cn(
          'px-2.5 py-1.5 rounded-lg font-medium border transition cursor-pointer',
          removeBg
            ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-400'
            : 'bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400'
        )}
        title="Eliminar automáticamente el fondo claro exterior"
      >
        {removeBg ? '🪄 Fondo: Auto' : '🖼️ Fondo: Mantiene'}
      </button>
    </div>
  )
}
</file>

<file path="src/hama/components/Guide/ExportPdfButton.tsx">
import { useState, useCallback } from 'react'
import { useHamaStore } from '@/hama/store/hama.store'
import { BEAD_TYPES } from '@/hama/core/palette.const'
import { computeModel3D } from '@/hama/core/voxelizer'
import { deriveAssemblySteps } from '@/hama/core/assembly-guide'
import { exportAssemblyManualPdf } from '@/hama/core/pdf-exporter'
import { cn } from '@/lib/utils'

interface Props {
  className?: string
  captureScreenshot?: () => string
  getPreviewSnapshot?: () => string
}

export default function ExportPdfButton({
  className,
  captureScreenshot,
  getPreviewSnapshot,
}: Props) {
  const [isExporting, setIsExporting] = useState(false)

  const gridData = useHamaStore((state) => state.gridData)
  const beadTypeId = useHamaStore((state) => state.beadTypeId)
  const widthCm = useHamaStore((state) => state.widthCm)
  const heightCm = useHamaStore((state) => state.heightCm)

  const mode3d = useHamaStore((state) => state.mode3d)
  const hollowLayersCount = useHamaStore((state) => state.hollowLayersCount)
  const hollowWallThickness = useHamaStore((state) => state.hollowWallThickness)
  const interlockingType = useHamaStore((state) => state.interlockingType)
  const interlockingDepthBeads = useHamaStore((state) => state.interlockingDepthBeads)
  const reliefLevels = useHamaStore((state) => state.reliefLevels)

  const beadType = BEAD_TYPES[beadTypeId] || BEAD_TYPES.midi

  // Generar modelo tridimensional
  const model3D = gridData
    ? computeModel3D(gridData, {
        mode3d,
        hollowLayersCount,
        hollowWallThickness,
        interlockingType,
        interlockingDepthBeads,
        reliefLevels,
        diameterMm: beadType.diameterMm,
      })
    : null

  const isAvailable = model3D !== null && model3D.totalBeads > 0

  const handleExport = useCallback(async () => {
    if (!model3D || isExporting) return

    setIsExporting(true)

    // Ceder el hilo para permitir el renderizado inmediato del spinner de carga
    setTimeout(async () => {
      try {
        const steps = deriveAssemblySteps(model3D)

        // Obtener captura de la escena 3D activa
        let coverPreviewDataUrl = ''
        if (captureScreenshot) {
          coverPreviewDataUrl = captureScreenshot()
        } else if (getPreviewSnapshot) {
          coverPreviewDataUrl = getPreviewSnapshot()
        }

        // Si no se proporcionó callback o devolvió cadena vacía, capturar del canvas WebGL en el DOM
        if (!coverPreviewDataUrl && typeof document !== 'undefined') {
          const webglCanvas = (document.querySelector('div[data-scene3d-canvas] canvas') ||
            document.querySelector('.cursor-grab canvas') ||
            document.querySelector('canvas[data-engine^="three.js"]')) as HTMLCanvasElement | null
          if (webglCanvas && typeof webglCanvas.toDataURL === 'function') {
            try {
              coverPreviewDataUrl = webglCanvas.toDataURL('image/png')
            } catch {
              coverPreviewDataUrl = ''
            }
          }
        }

        const depthCm = (model3D.dimensionsMm.z / 10).toFixed(1)
        const dimensionsCm = `${widthCm.toFixed(1)} × ${heightCm.toFixed(1)} × ${depthCm} cm`

        await exportAssemblyManualPdf({
          projectName: 'Hama Beads 3D Studio',
          beadTypeName: `${beadType.name} (${beadType.diameterMm} mm)`,
          dimensionsCm,
          model3D,
          steps,
          coverPreviewDataUrl,
        })
      } catch (err) {
        console.error('Error al generar el manual en PDF:', err)
      } finally {
        setIsExporting(false)
      }
    }, 50)
  }, [
    model3D,
    isExporting,
    captureScreenshot,
    getPreviewSnapshot,
    widthCm,
    heightCm,
    beadType.name,
    beadType.diameterMm,
  ])

  return (
    <button
      type="button"
      onClick={handleExport}
      disabled={!isAvailable || isExporting}
      className={cn(
        'relative inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs tracking-wide transition-all shadow-sm cursor-pointer',
        isAvailable && !isExporting
          ? 'bg-indigo-600 hover:bg-indigo-500 active:scale-[0.98] text-white shadow-indigo-500/25'
          : 'bg-slate-200 dark:bg-slate-800 text-slate-400 dark:text-slate-600 cursor-not-allowed opacity-75 shadow-none',
        className
      )}
      title={
        !isAvailable
          ? 'Carga un diseño para generar el manual de montaje'
          : 'Descarga un manual de instrucciones en PDF con cuadrículas y recuentos'
      }
    >
      {isExporting ? (
        <>
          <svg
            className="animate-spin -ml-1 mr-1.5 h-4 w-4 text-white"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            />
          </svg>
          <span>Generando Manual PDF...</span>
        </>
      ) : (
        <>
          <svg
            className="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              strokeLinecap="round"
              strokeLinejoin="round"
              strokeWidth={2}
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
          <span>Manual de Montaje PDF</span>
        </>
      )}
    </button>
  )
}
</file>

<file path="src/hama/components/Scene3D/LayerStackControls.tsx">
import { useHamaStore } from '@/hama/store/hama.store'
import type { Model3DResult } from '@/interfaces/hama-3d.interface'
import { cn } from '@/lib/utils'

interface Props {
  model3D: Model3DResult | null
  className?: string
}

export default function LayerStackControls({ model3D, className }: Props) {
  const explodedGapMm = useHamaStore((state) => state.explodedGapMm)
  const setExplodedGapMm = useHamaStore((state) => state.setExplodedGapMm)

  const activeLayerIndex = useHamaStore((state) => state.activeLayerIndex)
  const setActiveLayerIndex = useHamaStore((state) => state.setActiveLayerIndex)

  const mode3d = useHamaStore((state) => state.mode3d)

  // Opciones de capas o placas según el modelo activo
  const items: { index: number; name: string }[] = []
  if (model3D) {
    if (model3D.layers) {
      model3D.layers.forEach((l) => {
        items.push({ index: l.layerIndex, name: l.name })
      })
    } else if (model3D.plates) {
      model3D.plates.forEach((p, idx) => {
        items.push({ index: idx + 1, name: p.name })
      })
    }
  }

  return (
    <div
      className={cn(
        'bg-white/90 dark:bg-slate-900/90 backdrop-blur-md p-3.5 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-lg text-slate-800 dark:text-slate-100 space-y-3.5',
        className
      )}
    >
      {/* Control de Vista Explosionada */}
      <div>
        <div className="flex justify-between items-center text-xs">
          <div className="flex items-center gap-1.5 font-semibold">
            <span>💥 Vista Explosionada</span>
            {explodedGapMm > 0 && (
              <button
                type="button"
                onClick={() => setExplodedGapMm(0)}
                className="text-[10px] text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer"
                title="Volver a ensamblado compacto (0 mm)"
              >
                (Compactar)
              </button>
            )}
          </div>
          <span className="font-mono font-bold text-indigo-600 dark:text-indigo-400 text-xs">
            {explodedGapMm} mm
          </span>
        </div>

        <input
          type="range"
          min={0}
          max={50}
          step={1}
          value={explodedGapMm}
          onChange={(e) => setExplodedGapMm(Number(e.target.value))}
          className="mt-1.5 w-full accent-indigo-600 dark:accent-indigo-500 cursor-pointer"
        />

        <div className="flex justify-between text-[10px] text-slate-400">
          <span>0 mm (Ensamblado)</span>
          <span>50 mm (Despiece)</span>
        </div>
      </div>

      <div className="h-px bg-slate-200 dark:bg-slate-800" />

      {/* Selector de Capa / Placa Activa */}
      <div>
        <div className="flex justify-between items-center text-xs mb-1.5">
          <span className="font-semibold text-slate-700 dark:text-slate-300">
            {mode3d === 'interlocking' ? 'Placa Activa' : 'Capa Activa'}
          </span>
          {activeLayerIndex !== null ? (
            <button
              type="button"
              onClick={() => setActiveLayerIndex(null)}
              className="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300 hover:bg-amber-200 cursor-pointer transition-colors"
            >
              Aislamiento activo · Mostrar todo
            </button>
          ) : (
            <span className="text-[10px] text-slate-400 font-medium">
              Mostrando modelo completo
            </span>
          )}
        </div>

        <select
          value={activeLayerIndex === null ? 'all' : String(activeLayerIndex)}
          onChange={(e) => {
            const val = e.target.value
            setActiveLayerIndex(val === 'all' ? null : Number(val))
          }}
          className="w-full px-2.5 py-1.5 text-xs font-semibold rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer"
        >
          <option value="all">
            ✨ {mode3d === 'interlocking' ? 'Todas las placas (Ensambladas)' : 'Todas las capas (Apiladas)'}
          </option>
          {items.map((item) => (
            <option key={item.index} value={String(item.index)}>
              🔍 {item.name}
            </option>
          ))}
        </select>
      </div>
    </div>
  )
}
</file>

