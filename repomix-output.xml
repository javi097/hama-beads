  it('compone correctamente un manual para Ensamblado Interlocking (2 placas)', () => {
    const grid = createSolidGrid(4, 4, blackBead)
    const gridData: GridData = { cols: 4, rows: 4, cells: grid }

    const model3D = computeModel3D(gridData, {
