      {/* Parámetros específicos para Relieve por Luminancia */}
      {mode3d === 'relief' && (
        <div className="p-3 bg-white dark:bg-slate-900/80 rounded-lg border border-slate-200/80 dark:border-slate-800 space-y-3">
          <div>
